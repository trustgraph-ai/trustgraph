#!/usr/bin/env python3

"""
Loads the default set of planner capabilities into config for a
workspace.
"""

import json
import os
import sys
from trustgraph.api import Api
from trustgraph.api.types import ConfigValue

url = os.getenv("TRUSTGRAPH_URL", "http://localhost:8888/")
token = os.getenv("TRUSTGRAPH_TOKEN", None)
workspace = os.getenv("TRUSTGRAPH_WORKSPACE", "default")

CAPABILITIES = {
    "erp-finance-query": {
        "name": "erp-finance-query",
        "type": "tool",
        "description":
            "Queries the ERP system for financial data — invoices, "
            "budgets, cost centres. Query is passed as a step parameter.",
        "inputs": [],
        "outputs": [
            {"port": "result", "artifact_type": "TabularArtifact"},
        ],
    },
    "concept-extraction": {
        "name": "concept-extraction",
        "type": "retrieval",
        "description":
            "Extracts key concepts from a natural-language query "
            "using an LLM. Returns keywords suitable for downstream "
            "entity retrieval or tagging.",
        "inputs": [],
        "outputs": [
            {"port": "result", "artifact_type": "KeywordsArtifact"},
        ],
    },
    "knowledge-retrieval": {
        "name": "knowledge-retrieval",
        "type": "retrieval",
        "description":
            "Traverses the workspace knowledge graph from seed "
            "concepts or entities, returning scored edges as a "
            "subgraph.",
        "inputs": [
            {"port": "keywords", "artifact_type": "KeywordsArtifact"},
        ],
        "outputs": [
            {"port": "result", "artifact_type": "SubgraphArtifact"},
        ],
    },
    "graph-rag-query": {
        "name": "graph-rag-query",
        "type": "retrieval",
        "description":
            "Full graph RAG pipeline: concept extraction, knowledge "
            "retrieval, and LLM synthesis. Returns a natural-language "
            "answer.",
        "inputs": [],
        "outputs": [
            {"port": "result", "artifact_type": "TextBlobArtifact"},
        ],
    },
    "graph-embeddings-query": {
        "name": "graph-embeddings-query",
        "type": "retrieval",
        "description":
            "Performs a semantic similarity search over graph entities. "
            "Takes a natural-language query, embeds it, and returns "
            "ranked entity matches with scores and attributes.",
        "inputs": [],
        "outputs": [
            {"port": "result", "artifact_type": "EntityListArtifact"},
        ],
    },
    "entity-triples-query": {
        "name": "entity-triples-query",
        "type": "retrieval",
        "description":
            "Queries the knowledge graph for all triples containing "
            "the given entities. Accepts an EntityListArtifact or "
            "entity URIs as parameters. Returns a subgraph.",
        "inputs": [
            {"port": "entities", "artifact_type": "EntityListArtifact"},
        ],
        "outputs": [
            {"port": "result", "artifact_type": "SubgraphArtifact"},
        ],
    },
    "rerank": {
        "name": "rerank",
        "type": "adapter",
        "description":
            "Reranks items in an artifact by relevance to a query "
            "using a cross-encoder model. Accepts EntityListArtifact, "
            "SubgraphArtifact, or KeywordsArtifact. Returns the same "
            "artifact type filtered to the top-k most relevant items.",
        "inputs": [
            {"port": "entities", "artifact_type": "EntityListArtifact"},
            {"port": "subgraph", "artifact_type": "SubgraphArtifact"},
            {"port": "keywords", "artifact_type": "KeywordsArtifact"},
        ],
        "outputs": [
            {"port": "result", "artifact_type": "EntityListArtifact"},
            {"port": "result", "artifact_type": "SubgraphArtifact"},
            {"port": "result", "artifact_type": "KeywordsArtifact"},
        ],
    },
    "tabular-redact": {
        "name": "tabular-redact",
        "type": "redactor",
        "description":
            "Applies redaction rules to a tabular dataset — strips or "
            "masks rows/columns matching specified criteria.",
        "inputs": [
            {"port": "data", "artifact_type": "TabularArtifact"},
        ],
        "outputs": [
            {"port": "result", "artifact_type": "TabularArtifact"},
        ],
    },
    "tabular-join": {
        "name": "tabular-join",
        "type": "adapter",
        "description":
            "Joins tabular data with a subgraph on a shared key, "
            "optionally computing derived columns (e.g. variance).",
        "inputs": [
            {"port": "tabular-data", "artifact_type": "TabularArtifact"},
            {"port": "graph-data", "artifact_type": "SubgraphArtifact"},
        ],
        "outputs": [
            {"port": "result", "artifact_type": "TabularArtifact"},
        ],
    },
    "llm-synthesis": {
        "name": "llm-synthesis",
        "type": "llm",
        "description":
            "Synthesises a human-readable report from structured data "
            "and reference text using an LLM.",
        "inputs": [
            {"port": "data", "artifact_type": "TabularArtifact"},
            {"port": "context", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "report", "artifact_type": "ReportArtifact"},
        ],
    },
}

try:
    api = Api(url=url, token=token, workspace=workspace)
    config = api.config()

    values = [
        ConfigValue(
            type="planner-capability",
            key=key,
            value=json.dumps(cap),
        )
        for key, cap in CAPABILITIES.items()
    ]

    config.put(values)

    print(f"Loaded {len(values)} planner capabilities into workspace '{workspace}'")

except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
