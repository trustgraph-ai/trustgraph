#!/usr/bin/env python3

"""
Loads the default set of planner capabilities into config for a
workspace.
"""

import json
import os
import sys
from trustgraph.api import Api
from trustgraph.api.types import ConfigValue

url = os.getenv("TRUSTGRAPH_URL", "http://localhost:8888/")
token = os.getenv("TRUSTGRAPH_TOKEN", None)
workspace = os.getenv("TRUSTGRAPH_WORKSPACE", "default")

CAPABILITIES = {
    "query-formulation": {
        "name": "query-formulation",
        "type": "tool",
        "description":
            "Translates a natural-language question into a structured "
            "query specification for a named ERP schema. Returns a "
            "QuerySpecArtifact that downstream services execute.",
        "inputs": [
            {"port": "question", "artifact_type": "TextBlobArtifact"},
            {"port": "schema-name", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "query-spec", "artifact_type": "QuerySpecArtifact"},
        ],
    },
    "concept-extraction": {
        "name": "concept-extraction",
        "type": "retrieval",
        "description":
            "Extracts key concepts from a natural-language query "
            "using an LLM. Returns keywords suitable for downstream "
            "entity retrieval or tagging.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "keywords", "artifact_type": "KeywordsArtifact"},
        ],
    },
    "knowledge-retrieval": {
        "name": "knowledge-retrieval",
        "type": "retrieval",
        "description":
            "Traverses the workspace knowledge graph from seed "
            "concepts or entities, returning scored edges as a "
            "subgraph.",
        "inputs": [
            {
                "port": "keywords",
                "artifact_type": "KeywordsArtifact",
                "optional": True,
            },
            {
                "port": "entities",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {"port": "subgraph", "artifact_type": "SubgraphArtifact"},
        ],
    },
    "graph-rag-query": {
        "name": "graph-rag-query",
        "type": "retrieval",
        "description":
            "Full graph RAG pipeline: concept extraction, knowledge "
            "retrieval, and LLM synthesis. Returns a natural-language "
            "answer.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "response", "artifact_type": "TextBlobArtifact"},
        ],
    },
    "graph-embeddings-query": {
        "name": "graph-embeddings-query",
        "type": "retrieval",
        "description":
            "Performs a semantic similarity search over graph entities. "
            "Takes a natural-language query, embeds it, and returns "
            "ranked entity matches with scores and attributes.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "entities", "artifact_type": "EntityListArtifact"},
        ],
    },
    "entity-triples-query": {
        "name": "entity-triples-query",
        "type": "retrieval",
        "description":
            "Queries the knowledge graph for all triples containing "
            "the given entities. Accepts an EntityListArtifact from a "
            "previous step, or entity URIs as text. Returns a subgraph.",
        "inputs": [
            {
                "port": "entity-list",
                "artifact_type": "EntityListArtifact",
                "optional": True,
            },
            {
                "port": "entities",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {"port": "subgraph", "artifact_type": "SubgraphArtifact"},
        ],
    },
    "document-rag-query": {
        "name": "document-rag-query",
        "type": "retrieval",
        "description":
            "Performs document-level RAG: embeds the query, retrieves "
            "matching document chunks, and synthesises an answer.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
        ],
        "outputs": [
            {"port": "response", "artifact_type": "TextBlobArtifact"},
        ],
    },
    "sparql-query": {
        "name": "sparql-query",
        "type": "retrieval",
        "description":
            "Runs a SPARQL query against the knowledge graph. "
            "Returns tabular results for SELECT, a subgraph for "
            "CONSTRUCT/DESCRIBE, or text for ASK.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
            {
                "port": "variables",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {
                "port": "result",
                "artifact_type": [
                    "TextBlobArtifact",
                    "SubgraphArtifact",
                    "TabularArtifact",
                ],
            },
        ],
    },
    "rerank": {
        "name": "rerank",
        "type": "adapter",
        "description":
            "Reranks items in an artifact by relevance to a query "
            "using a cross-encoder model. Accepts EntityListArtifact, "
            "SubgraphArtifact, or KeywordsArtifact. Returns the same "
            "artifact type filtered to the top-k most relevant items.",
        "inputs": [
            {"port": "query", "artifact_type": "TextBlobArtifact"},
            {
                "port": "data",
                "artifact_type": [
                    "EntityListArtifact",
                    "SubgraphArtifact",
                    "KeywordsArtifact",
                ],
            },
        ],
        "outputs": [
            {
                "port": "data",
                "artifact_type": [
                    "EntityListArtifact",
                    "SubgraphArtifact",
                    "KeywordsArtifact",
                ],
            },
        ],
    },
    "tabular-redact": {
        "name": "tabular-redact",
        "type": "redactor",
        "description":
            "Applies redaction rules to a tabular dataset — strips or "
            "masks specified columns.",
        "inputs": [
            {"port": "data", "artifact_type": "TabularArtifact"},
            {"port": "columns", "artifact_type": "TextBlobArtifact"},
            {
                "port": "method",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {"port": "data", "artifact_type": "TabularArtifact"},
        ],
    },
    "tabular-join": {
        "name": "tabular-join",
        "type": "adapter",
        "description":
            "Joins tabular data with a subgraph on a shared key, "
            "enriching rows with graph properties as new columns.",
        "inputs": [
            {"port": "tabular", "artifact_type": "TabularArtifact"},
            {"port": "graph", "artifact_type": "SubgraphArtifact"},
            {
                "port": "join-key",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {"port": "data", "artifact_type": "TabularArtifact"},
        ],
    },
    "query-spec-join": {
        "name": "query-spec-join",
        "type": "adapter",
        "description":
            "Joins two QuerySpecArtifacts into a single join-type "
            "QuerySpec using foreign key relationships declared in "
            "their embedded schemas. No LLM call — pure data "
            "transformation.",
        "inputs": [
            {"port": "left", "artifact_type": "QuerySpecArtifact"},
            {"port": "right", "artifact_type": "QuerySpecArtifact"},
        ],
        "outputs": [
            {"port": "query-spec", "artifact_type": "QuerySpecArtifact"},
        ],
    },
    "llm-synthesis": {
        "name": "llm-synthesis",
        "type": "llm",
        "description":
            "Synthesises a human-readable report from structured data "
            "and reference text using an LLM.",
        "inputs": [
            {
                "port": "data",
                "artifact_type": "TabularArtifact",
                "optional": True,
            },
            {
                "port": "context",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
            {
                "port": "goal",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
            {
                "port": "prompt",
                "artifact_type": "TextBlobArtifact",
                "optional": True,
            },
        ],
        "outputs": [
            {"port": "report", "artifact_type": "ReportArtifact"},
        ],
    },
}

try:
    api = Api(url=url, token=token, workspace=workspace)
    config = api.config()

    values = [
        ConfigValue(
            type="planner-capability",
            key=key,
            value=json.dumps(cap),
        )
        for key, cap in CAPABILITIES.items()
    ]

    config.put(values)

    print(f"Loaded {len(values)} planner capabilities into workspace '{workspace}'")

except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
