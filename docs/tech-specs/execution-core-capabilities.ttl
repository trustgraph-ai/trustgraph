# Capability definitions for the Financial Spend Review flow trace
# (execution-core-flow-trace.md, Use Case 1).
#
# These are example registrations — the kind of data a workspace would
# hold in its capability registry for the Planner to browse.

@prefix tg-exec: <https://trustgraph.ai/ontology/exec/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix cap:     <urn:tg:capability:> .
@prefix port:    <urn:tg:port:> .

# ── Source capabilities (no input ports) ────────────────────────────

cap:erp-finance-query a tg-exec:Capability ;
    tg-exec:capabilityId  "erp-finance-query" ;
    tg-exec:capabilityType tg-exec:tool ;
    rdfs:label   "ERP Finance Query" ;
    rdfs:comment "Queries the ERP system for financial data — invoices, budgets, cost centres. The query is passed as a step parameter." ;
    tg-exec:emitsOutput port:erp-finance-query-out .

port:erp-finance-query-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .


cap:concept-extraction a tg-exec:Capability ;
    tg-exec:capabilityId  "concept-extraction" ;
    tg-exec:capabilityType tg-exec:retrieval ;
    rdfs:label   "Concept Extraction" ;
    rdfs:comment "Extracts key concepts from a natural-language query using an LLM. Returns keywords suitable for downstream entity retrieval or tagging." ;
    tg-exec:emitsOutput port:concept-extraction-out .

port:concept-extraction-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:KeywordsArtifact ;
    tg-exec:required     true .


cap:knowledge-retrieval a tg-exec:Capability ;
    tg-exec:capabilityId  "knowledge-retrieval" ;
    tg-exec:capabilityType tg-exec:retrieval ;
    rdfs:label   "Knowledge Retrieval" ;
    rdfs:comment "Traverses the workspace knowledge graph from seed concepts or entities, returning scored edges as a subgraph." ;
    tg-exec:acceptsInput port:knowledge-retrieval-in ;
    tg-exec:emitsOutput  port:knowledge-retrieval-out .

port:knowledge-retrieval-in a tg-exec:PortContract ;
    tg-exec:portName     "keywords" ;
    tg-exec:artifactType tg-exec:KeywordsArtifact ;
    tg-exec:required     false .

port:knowledge-retrieval-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:SubgraphArtifact ;
    tg-exec:required     true .


cap:graph-rag-query a tg-exec:Capability ;
    tg-exec:capabilityId  "graph-rag-query" ;
    tg-exec:capabilityType tg-exec:retrieval ;
    rdfs:label   "Graph RAG Query" ;
    rdfs:comment "Full graph RAG pipeline: concept extraction, knowledge retrieval, and LLM synthesis. Returns a natural-language answer." ;
    tg-exec:emitsOutput port:graph-rag-query-out .

port:graph-rag-query-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:TextBlobArtifact ;
    tg-exec:required     true .


cap:graph-embeddings-query a tg-exec:Capability ;
    tg-exec:capabilityId  "graph-embeddings-query" ;
    tg-exec:capabilityType tg-exec:retrieval ;
    rdfs:label   "Graph Embeddings Query" ;
    rdfs:comment "Performs a semantic similarity search over graph entities. Takes a natural-language query, embeds it, and returns ranked entity matches with scores and attributes." ;
    tg-exec:emitsOutput port:graph-embeddings-query-out .

port:graph-embeddings-query-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:EntityListArtifact ;
    tg-exec:required     true .


cap:entity-triples-query a tg-exec:Capability ;
    tg-exec:capabilityId  "entity-triples-query" ;
    tg-exec:capabilityType tg-exec:retrieval ;
    rdfs:label   "Entity Triples Query" ;
    rdfs:comment "Queries the knowledge graph for all triples containing the given entities. Accepts an EntityListArtifact or entity URIs as parameters. Returns a subgraph." ;
    tg-exec:acceptsInput port:entity-triples-query-in ;
    tg-exec:emitsOutput  port:entity-triples-query-out .

port:entity-triples-query-in a tg-exec:PortContract ;
    tg-exec:portName     "entities" ;
    tg-exec:artifactType tg-exec:EntityListArtifact ;
    tg-exec:required     false .

port:entity-triples-query-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:SubgraphArtifact ;
    tg-exec:required     true .


cap:rerank a tg-exec:Capability ;
    tg-exec:capabilityId  "rerank" ;
    tg-exec:capabilityType tg-exec:adapter ;
    rdfs:label   "Rerank" ;
    rdfs:comment "Reranks items in an artifact by relevance to a query using a cross-encoder model. Accepts EntityListArtifact, SubgraphArtifact, or KeywordsArtifact. Returns the same type filtered to top-k." ;
    tg-exec:acceptsInput port:rerank-in-entities ;
    tg-exec:acceptsInput port:rerank-in-subgraph ;
    tg-exec:acceptsInput port:rerank-in-keywords ;
    tg-exec:emitsOutput  port:rerank-out-entities ;
    tg-exec:emitsOutput  port:rerank-out-subgraph ;
    tg-exec:emitsOutput  port:rerank-out-keywords .

port:rerank-in-entities a tg-exec:PortContract ;
    tg-exec:portName     "entities" ;
    tg-exec:artifactType tg-exec:EntityListArtifact ;
    tg-exec:required     false .

port:rerank-in-subgraph a tg-exec:PortContract ;
    tg-exec:portName     "subgraph" ;
    tg-exec:artifactType tg-exec:SubgraphArtifact ;
    tg-exec:required     false .

port:rerank-in-keywords a tg-exec:PortContract ;
    tg-exec:portName     "keywords" ;
    tg-exec:artifactType tg-exec:KeywordsArtifact ;
    tg-exec:required     false .

port:rerank-out-entities a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:EntityListArtifact ;
    tg-exec:required     false .

port:rerank-out-subgraph a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:SubgraphArtifact ;
    tg-exec:required     false .

port:rerank-out-keywords a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:KeywordsArtifact ;
    tg-exec:required     false .


# ── Transform capabilities ──────────────────────────────────────────

cap:tabular-redact a tg-exec:Capability ;
    tg-exec:capabilityId  "tabular-redact" ;
    tg-exec:capabilityType tg-exec:redactor ;
    rdfs:label   "Tabular Redaction" ;
    rdfs:comment "Applies redaction rules to a tabular dataset — strips or masks rows/columns matching the specified criteria." ;
    tg-exec:acceptsInput port:tabular-redact-in ;
    tg-exec:emitsOutput  port:tabular-redact-out .

port:tabular-redact-in a tg-exec:PortContract ;
    tg-exec:portName     "data" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .

port:tabular-redact-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .


cap:tabular-join a tg-exec:Capability ;
    tg-exec:capabilityId  "tabular-join" ;
    tg-exec:capabilityType tg-exec:adapter ;
    rdfs:label   "Tabular Join" ;
    rdfs:comment "Joins tabular data with a subgraph on a shared key, optionally computing derived columns (e.g. variance)." ;
    tg-exec:acceptsInput port:tabular-join-in-tabular ;
    tg-exec:acceptsInput port:tabular-join-in-graph ;
    tg-exec:emitsOutput  port:tabular-join-out .

port:tabular-join-in-tabular a tg-exec:PortContract ;
    tg-exec:portName     "tabular-data" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .

port:tabular-join-in-graph a tg-exec:PortContract ;
    tg-exec:portName     "graph-data" ;
    tg-exec:artifactType tg-exec:SubgraphArtifact ;
    tg-exec:required     true .

port:tabular-join-out a tg-exec:PortContract ;
    tg-exec:portName     "result" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .


# ── Synthesis capabilities ──────────────────────────────────────────

cap:llm-synthesis a tg-exec:Capability ;
    tg-exec:capabilityId  "llm-synthesis" ;
    tg-exec:capabilityType tg-exec:llm ;
    rdfs:label   "LLM Synthesis" ;
    rdfs:comment "Synthesises a human-readable report from structured data and reference text using an LLM." ;
    tg-exec:acceptsInput port:llm-synthesis-in-data ;
    tg-exec:acceptsInput port:llm-synthesis-in-context ;
    tg-exec:emitsOutput  port:llm-synthesis-out .

port:llm-synthesis-in-data a tg-exec:PortContract ;
    tg-exec:portName     "data" ;
    tg-exec:artifactType tg-exec:TabularArtifact ;
    tg-exec:required     true .

port:llm-synthesis-in-context a tg-exec:PortContract ;
    tg-exec:portName     "context" ;
    tg-exec:artifactType tg-exec:TextBlobArtifact ;
    tg-exec:required     true .

port:llm-synthesis-out a tg-exec:PortContract ;
    tg-exec:portName     "report" ;
    tg-exec:artifactType tg-exec:ReportArtifact ;
    tg-exec:required     true .
